{
  "author": "OpenKrill",
  "authorUrl": "https://tools.openkrill.app",
  "category": "productivity",
  "cloudEndpoint": "https://jobs.openkrill.app/mcp",
  "description": "Open jobs at the companies you name, read straight from their public careers boards, ranked for your profile with a resume checklist per job. Hosted and keyless.",
  "homepage": "https://github.com/nguyenhieuec/company-jobs-mcp",
  "icon": "https://raw.githubusercontent.com/nguyenhieuec/company-jobs-mcp/main/icon.png",
  "identifier": "openkrill-company-jobs",
  "name": "Company Jobs Finder",
  "tags": [
    "jobs",
    "careers",
    "job-search",
    "greenhouse",
    "lever",
    "ashby",
    "resume"
  ],
  "tools": [
    {
      "name": "find_company_jobs",
      "title": "Find company jobs and careers",
      "description": "Find open jobs at specific companies. Use it for questions like \"jobs at Stripe\", \"is Notion hiring designers?\", \"remote backend jobs at Ramp and Linear\" or \"which Spotify jobs list a salary?\". Pass company names as the user says them, or careers page links, up to 5 at a time. Covers companies whose careers pages run on Greenhouse, Lever, Ashby, Workable or SmartRecruiters; others come back as not_found. Optional filters: keyword, location, remote, department, postedSince, withSalary. Returns each job's title, locations, workplace type, salary when published, posting date, a short summary and the application link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1,
            "maxItems": 5,
            "description": "Company names as the user says them (\"Stripe\", \"Hugging Face\"), or careers page links. At most 5."
          },
          "keyword": {
            "type": "string",
            "maxLength": 200,
            "description": "Words that must appear in the job, such as \"designer\" or \"backend\""
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "description": "City, country name or ISO country code, such as \"London\" or \"DE\""
          },
          "remote": {
            "type": "boolean",
            "description": "true to keep only remote jobs"
          },
          "department": {
            "type": "string",
            "maxLength": 200,
            "description": "Department or team, such as \"Engineering\""
          },
          "postedSince": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}",
            "description": "ISO date; keep jobs posted on or after it"
          },
          "withSalary": {
            "type": "boolean",
            "description": "true to keep only jobs that publish a salary"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Most jobs per company (default 10)"
          }
        },
        "required": [
          "companies"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "not_found",
                    "unavailable"
                  ]
                },
                "company": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "boardUrl": {
                  "type": "string"
                },
                "jobs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "department": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "locations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "workplace": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "remote",
                          "hybrid",
                          "onsite",
                          null
                        ]
                      },
                      "employmentType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "salary": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "min": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "max": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "currency": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "interval": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      },
                      "postedOn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "applyUrl": {
                        "type": "string"
                      },
                      "summary": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "title",
                      "locations",
                      "applyUrl"
                    ]
                  }
                },
                "moreAvailable": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "status"
              ]
            }
          }
        },
        "required": [
          "companies"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "rank_jobs_for_profile",
      "title": "Rank company jobs for profile",
      "description": "Rank the open jobs at up to 3 companies for a person's profile. Use it when the user wants to know which jobs suit them, for questions like \"which of these jobs fit a senior backend engineer with 7 years of Go?\". Pass companies and the profile the user gave: targetTitles, and where known recentTitles, level, yearsExperience, skills, locations and openToRemote. Every posting is scored on title, level, location and then, for the best ones, skills and years asked. Returns the jobs ranked with a score, a level-fit verdict (match, step_up, stretch, step_down), the reasons it fits and the gaps. A rule-based match to public postings, not a prediction of being hired. The profile is used only while the call runs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "Company names or careers page links to rank jobs from. At most 3."
          },
          "targetTitles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 5,
            "description": "Job titles the person is aiming for, such as \"Backend Engineer\". 1 to 5."
          },
          "recentTitles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 2,
            "description": "Titles of their most recent one or two roles; recruiters weigh these most."
          },
          "level": {
            "type": "string",
            "enum": [
              "intern",
              "entry",
              "mid",
              "senior",
              "lead",
              "staff",
              "principal",
              "manager",
              "director",
              "executive"
            ],
            "description": "Their current level, if known. Otherwise it is read from recentTitles or yearsExperience."
          },
          "yearsExperience": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "description": "Years of relevant experience"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "minItems": 0,
            "maxItems": 30,
            "description": "Key skills and tools, such as \"Go\" or \"PostgreSQL\". Up to 30."
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 5,
            "description": "Cities or countries they would work in, such as \"London\" or \"DE\". Up to 5."
          },
          "openToRemote": {
            "type": "boolean",
            "description": "true if remote roles are fine, false to avoid them. Leave out if no preference."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Most ranked jobs to return (default 10)"
          }
        },
        "required": [
          "companies",
          "targetTitles"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ranked": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "locations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "workplace": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "applyUrl": {
                  "type": "string"
                },
                "score": {
                  "type": "integer"
                },
                "fit": {
                  "type": "string",
                  "enum": [
                    "strong",
                    "possible",
                    "weak"
                  ]
                },
                "levelFit": {
                  "type": "object",
                  "properties": {
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "match",
                        "step_up",
                        "stretch",
                        "step_down",
                        "unknown"
                      ]
                    },
                    "job": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "you": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "basis": {
                      "type": "string"
                    }
                  }
                },
                "whyFit": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "gaps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "rank",
                "title",
                "company",
                "applyUrl",
                "score",
                "fit",
                "levelFit",
                "whyFit",
                "gaps"
              ]
            }
          },
          "boards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "not_found",
                    "unavailable"
                  ]
                },
                "company": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "boardUrl": {
                  "type": "string"
                },
                "jobsOnBoard": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "status"
              ]
            }
          },
          "shortlisted": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ranked",
          "boards",
          "shortlisted",
          "notes"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
